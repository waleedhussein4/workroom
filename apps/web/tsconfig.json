{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // React models optional props as `prop?: T`, and both React itself and
    // most component libraries pass `undefined` explicitly rather than
    // omitting the key. exactOptionalPropertyTypes rejects that, so it fights
    // the ecosystem here for no real safety gain. It stays enabled in
    // packages/core, where the domain types are ours and it does earn its keep.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
