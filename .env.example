# Copy to .env.local (apps/web) and .env (apps/sync). Never commit real values.

# --- Database -------------------------------------------------------------
# Neon pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (Better Auth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Realtime -------------------------------------------------------------
# Signs the short-lived room-scoped tickets the browser uses to open a
# WebSocket. Must be identical on the web app and the sync server.
REALTIME_JWT_SECRET=""

# Shared secret for the web app to publish board events to the sync server.
# Must be identical on both.
SYNC_INTERNAL_SECRET=""

# Sync server, as reached from the browser.
NEXT_PUBLIC_SYNC_URL="ws://localhost:1234"

# Sync server HTTP base, as reached from the web app server-side.
SYNC_INTERNAL_URL="http://localhost:1234"

# --- Email ----------------------------------------------------------------
# Without these, confirmation and invitation links are printed to the server
# console instead of being sent, and email confirmation is skipped so sign-up
# still completes. Set both to turn confirmation on.
#
# A Resend key from https://resend.com/api-keys needs no domain to start, but
# the shared onboarding@resend.dev sender only delivers to the address that
# owns the account. Verify a domain to reach anybody else.
RESEND_API_KEY=""
EMAIL_FROM="Workroom <onboarding@resend.dev>"

# Forces email confirmation on or off regardless of the above. The end-to-end
# suite sets "false" so sign-up tests do not have to read server logs.
AUTH_REQUIRE_EMAIL_VERIFICATION=""

# --- Monitoring -----------------------------------------------------------
# Sentry stays entirely off without a DSN, so leaving these blank is a
# supported configuration rather than a broken one.
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
