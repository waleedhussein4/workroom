{
  "name": "workroom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative workspace — Kanban boards and live docs for small teams.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:realtime": "node scripts/probe-realtime-auth.mjs",
    "dev:sync": "npm run dev --workspace @workroom/sync",
    "dev:web": "npm run dev --workspace @workroom/web",
    "db:generate": "npm run generate --workspace @workroom/db",
    "db:migrate": "npm run migrate --workspace @workroom/db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
